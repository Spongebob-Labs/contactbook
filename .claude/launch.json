{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "web",
        "dev"
      ],
      "port": 5173,
      "url": "http://localhost:5173",
      "autoPort": true
    },
    {
      "name": "web-card-stub",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "web",
        "preview:stub"
      ],
      "port": 3100,
      "url": "http://localhost:3100"
    },
    {
      "name": "app-stub-dev",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd apps/web && (STUB_API_PORT=8788 node tests/stubs/api.mjs &) && API_BASE_URL=http://localhost:8788 NEXT_PUBLIC_API_DIRECT=0 exec pnpm exec next dev --port 3101"
      ],
      "port": 3101,
      "url": "http://localhost:3101"
    }
  ]
}