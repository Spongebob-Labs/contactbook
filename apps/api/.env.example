# Copy to apps/api/.env for local development.
#
# Nothing here is required to boot in development — the zod schema in
# src/config/env.schema.ts only enforces these once NODE_ENV=production, so a
# fresh clone starts without any credentials.

NODE_ENV=development
APP_ENV=local
PORT=8000
LOG_LEVEL=debug

# --- Database -------------------------------------------------------------
# Local Docker Postgres (docker/docker-compose.dev.yml). No pooler in front of
# it, so DATABASE_URL and DIRECT_URL are the same connection.
#
# Against Supabase these MUST differ: DATABASE_URL is the transaction pooler on
# :6543 with ?pgbouncer=true, DIRECT_URL is session mode on :5432 for migrations.
DATABASE_URL="postgresql://contactbook:localdev@127.0.0.1:5432/contactbook?schema=public"
DIRECT_URL="postgresql://contactbook:localdev@127.0.0.1:5432/contactbook?schema=public"

# --- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=7d
JWT_REFRESH_TTL=30d

# 32 bytes, base64. openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# --- Twilio ---------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Approved Content Template SID for the OTP message. Leave unset locally —
# without it, OTP requests return the code directly in the API response
# instead of sending it, so the whole login flow is testable with no Twilio
# account at all. See src/auth/otp.service.ts.
TWILIO_OTP_CONTENT_SID=

# --- GCP / Cloud Tasks ----------------------------------------------------
GCP_PROJECT_ID=
GCP_REGION=europe-west2

# Profile photo storage. Leave unset locally to develop everything except
# POST /profile/photo — every other profile endpoint works without it.
GCS_PROFILE_PHOTOS_BUCKET=
# Defaults to the bucket's own storage.googleapis.com URL when unset.
GCS_PUBLIC_BASE_URL=

# 'inline' runs task handlers in-process on the next tick, so local dev needs no
# public URL and no ngrok. Production refuses this value — see env.schema.ts.
TASK_TRANSPORT=inline
TASKS_QUEUE_OUTBOUND=
TASKS_QUEUE_PRIORITY=
TASKS_TARGET_BASE_URL=
TASKS_OIDC_AUDIENCE=
TASKS_INVOKER_SA=

# --- Web ------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000
SHARE_BASE_URL=http://localhost:3000

SENTRY_DSN=

# --- Google Wallet (optional) ---------------------------------------------
# All four or none — a partial set fails the boot (env.schema.ts). Left blank,
# the feature is off: GET /cards/:id/google-wallet-pass answers
# 409 GOOGLE_WALLET_NOT_CONFIGURED and nothing ever calls Google.
# Issuer ID from pay.google.com/business/console.
GOOGLE_WALLET_ISSUER_ID=
# `client_email` from the service account JSON key (role: Wallet Object Issuer).
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
# base64 of the `private_key` PEM from that same JSON key:
#   jq -r '.private_key' key.json | base64 | tr -d '\n'
GOOGLE_WALLET_SERVICE_ACCOUNT_KEY_B64=
# Class ID becomes `<issuerId>.<suffix>`. "card" is fine.
GOOGLE_WALLET_CLASS_SUFFIX=
