// Scope note: this is NOT the full schema from docs/architecture/lld.md yet.
// Card/ShareLink/Contact/WhatsAppTemplate landed 2026-08-23 (curation, a
// contact registry with bulk import, live public resolver, and the actual
// WhatsApp send wired through the outbox). Contact is named Recipient in
// lld.md's original draft — renamed to match product usage; a card is
// still shared by contactId, one at a time. Still missing: CardVersion
// (diffing, needs the notify-on-update feature), Broadcast/BroadcastTarget
// (batch send + per-target delivery tracking across many contacts at once),
// ShareLinkFieldOverride (per-contact field hiding), ScanCode, LinkEvent.
// See docs/architecture/sprint-plan.md.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: no connection URL here. Migrate reads its connection from
// prisma.config.ts; the running app passes a driver adapter to the
// PrismaClient constructor (see src/prisma/prisma.service.ts). Both still
// read DATABASE_URL / DIRECT_URL from the environment — just not from this file.
datasource db {
  provider = "postgresql"
}

// ==========================================
// AUTH
// ==========================================

/// Passwordless: verifying an OTP for a phone number that has never been seen
/// creates the User, with every identity field null until onboarding.
///
/// firstName/lastName/email live here, not as ProfileFields, because they are
/// account identity rather than a shareable/removable fact — collected once
/// at onboarding via POST /profile/onboarding. There is deliberately no
/// separate "primary phone" column: phoneE164 IS the primary phone, the one
/// number the system has actually OTP-verified. A second, freely-typed,
/// unverified "primary phone" would undermine that everywhere WhatsApp
/// delivery assumes phoneE164 is reachable.
model User {
  id                           String    @id @default(uuid())
  phoneE164                    String    @unique
  displayName                  String?
  firstName                    String?
  lastName                     String?
  email                        String?
  /// Set once, server-side only, by POST /profile/onboarding. Its presence is
  /// what makes that endpoint 409 on a second call — onboarding is one-shot;
  /// every edit after it goes through the granular field/group CRUD instead.
  profileOnboardingCompletedAt DateTime?
  isActive                     Boolean   @default(true)
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  refreshTokens   RefreshToken[]
  profileFields   ProfileField[]
  fieldGroups     ProfileFieldGroup[]
  cards           Card[]
  contacts        Contact[]
  inboundMessages InboundMessage[]

  @@map("users")
}

/// One row per OTP request. The code itself is never stored — only its bcrypt
/// hash. `attempts` bounds brute force against a single 6-digit code.
model OtpChallenge {
  id         String    @id @default(uuid())
  phoneE164  String
  codeHash   String
  attempts   Int       @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([phoneE164, expiresAt])
  @@map("otp_challenges")
}

/// Rotating refresh tokens. `tokenHash` is SHA-256 (deterministic — looked up
/// by exact match), unlike the OTP's bcrypt hash which is only ever compared,
/// never searched by. Reusing an already-rotated token (replacedById set)
/// revokes the whole family: that pattern is how a stolen refresh token gets
/// detected after the legitimate client already rotated past it.
model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  familyId     String
  replacedById String?
  revokedAt    DateTime?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ==========================================
// PROFILE
// ==========================================

/// Groups fields for display — which section of the profile editor a field
/// sits in. Orthogonal to FieldType: a CUSTOM-typed field can belong to any
/// category, and a PHONE-typed field is usually PERSONAL or WORK depending on
/// which number it is.
enum FieldCategory {
  IDENTITY
  PERSONAL
  WORK
  BUSINESS
  SOCIAL
  FINANCIAL
  CUSTOM
}

/// What KIND of data the field holds — governs input validation on the client
/// and, for the three financial types, whether the value is encrypted at rest.
enum FieldType {
  PHONE
  LANDLINE
  FAX
  EMAIL
  ADDRESS
  URL
  SOCIAL_LINK
  PHOTO
  TEXT
  DATE
  JOB_TITLE
  COMPANY
  REG_NUMBER
  DEPARTMENT
  RELATION
  STATUS
  LOCATION_TRACKING
  BANK_ACCOUNT
  DIGITAL_WALLET
  CRYPTO_WALLET
  CUSTOM
}

/// The kind of repeatable, named thing a ProfileFieldGroup represents. A
/// narrower enum than FieldCategory on purpose — PERSONAL and IDENTITY are
/// singular per user (you have one "personal" set of fields, not several),
/// so they are never grouped; only genuinely repeatable things are.
enum FieldGroupCategory {
  WORK
  BUSINESS
  SOCIAL
  FINANCIAL
}

/// One instance of a repeatable structured thing: one specific job, one
/// specific business, one specific bank account, one specific social
/// profile. Exists so "these four fields are Acme Corp's" is expressible —
/// the flat ProfileField list alone has no way to say that.
///
/// Deliberately NOT a parallel field model: a group is a label over a set of
/// ordinary ProfileFields (via ProfileField.groupId), not a new place values
/// live. Cards still pick individual ProfileFields regardless of grouping —
/// "share my Acme Corp work email but not my work phone" — so sharing never
/// has to reach across two different field representations.
model ProfileFieldGroup {
  id         String             @id @default(uuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   FieldGroupCategory
  /// User-chosen label for the instance — "Acme Corp", "Freelance", "HDFC
  /// Savings". Not required: a group can exist before it's named.
  tag        String?
  position   Int                @default(0)
  archivedAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  fields ProfileField[]

  @@index([userId, category, archivedAt, position])
  @@map("profile_field_groups")
}

/// A single entry in a user's profile. There is no fixed "Profile" row with
/// nullable columns for phone/email/etc — a user's profile IS this list, and
/// every field on it is optional by construction: it either exists or it
/// doesn't, rather than existing-but-empty. This is also what makes cards
/// possible later: a Card is just a chosen subset of a user's ProfileFields.
///
/// PHOTO is a field type like any other, but its value can only be set via
/// the upload endpoint (POST /profile/photo) — the value is a GCS object URL,
/// never a client-supplied string, since there is no meaningful "type a photo
/// URL yourself" path we want to support.
model ProfileField {
  id          String             @id @default(uuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    FieldCategory
  type        FieldType
  label       String
  /// Encrypted at rest (AES-256-GCM, AAD bound to userId+fieldId+type) when
  /// `type` is BANK_ACCOUNT, DIGITAL_WALLET, or CRYPTO_WALLET. See
  /// src/crypto/field-encryption.util.ts. Never logged at any level — the
  /// logger's redact() drops any key literally named `value`.
  value       String
  isEncrypted Boolean            @default(false)
  position    Int                @default(0)
  /// Null for a "loose" field (personal phone, personal email — things that
  /// don't repeat). Set when the field belongs to one instance of a
  /// repeatable thing (this job's phone, this bank account's IFSC). Cascades:
  /// a group's fields don't mean anything once the group they describe is gone.
  groupId     String?
  group       ProfileFieldGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Soft delete. An archived field vanishes from the live profile and from
  /// any card that included it, but is never hard-deleted — a card's
  /// historical "what did I share" record should survive the source field
  /// being removed.
  archivedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  cardFields CardField[]

  @@index([userId, archivedAt, position])
  @@index([groupId, position])
  @@map("profile_fields")
}

// ==========================================
// SHARING
// ==========================================

enum CardKind {
  WORK
  PERSONAL
  PAYMENT
  CUSTOM
}

/// A named, curated subset of the owner's ProfileFields — "what I show this
/// group of people." A Card holds no values itself; CardField just points at
/// which ProfileFields are included, so editing a ProfileField updates every
/// card (and every live ShareLink) that includes it automatically.
///
/// Deliberately missing vs. the fuller docs/architecture/lld.md draft:
/// `theme` (no dashboard UI to theme yet). `slug` never lands as such —
/// `publicToken` below is what the QR/public-URL problem actually needed, not
/// a human-readable slug.
model Card {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  kind       CardKind  @default(CUSTOM)
  archivedAt DateTime? // cascades to REVOKE every ShareLink on this card — see SharingService.archiveCard

  /// Bumped by CardsService.setFields() only when the field/visibility/
  /// position/label set actually changes — never by the appearance-only
  /// PATCH (a palette swap isn't content a recipient can even perceive as
  /// "the card changed"). Denormalized rather than derived from
  /// MAX(CardVersion.version) so setFields() can compute the next version
  /// from the row it already has in hand, in the same transaction it writes
  /// the CardVersion row — never one without the other.
  currentVersion Int @default(1)

  /// The card's own public URL, independent of any recipient. Scanned via QR
  /// before the card has ever been shared with anyone — resolves through the
  /// same GET /public/links/:token as a ShareLink token (ShareLinksService
  /// .resolvePublic falls back here on a miss), never a separate route. Never
  /// tied to one contact: revoking a contact's ShareLink must not affect this.
  /// 128-bit base62 via the same generateShareToken() ShareLink already uses —
  /// one generator, one entropy guarantee, across both token namespaces.
  publicToken String @unique

  // Appearance. All nullable and all NULL until the owner explicitly picks one —
  // NULL is load-bearing, it means "derive the look from `kind` instead," the
  // fallback both the owner app and the public page already implement. No
  // backfill needed: an existing card with everything NULL renders exactly as
  // it does today.
  templateId      String? // "meridian" | "marigold"
  paletteId       String? // "onyx" | "sapphire" | "emerald" | "oxblood" | "rust" | "amber" | "clay" | "pistachio" | "periwinkle"
  groundHex       String? // free colour, #RRGGBB — overrides paletteId when set
  finish          String? // surface finish, FE-owned value set
  texture         String? // motif, FE-owned value set, "none" included
  texturePresence String? // how strongly the texture reads, FE-owned value set
  textureScale    String? // multiplier on the texture tile, FE-owned value set

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fields     CardField[]
  shareLinks ShareLink[]
  scans      CardScan[]
  versions   CardVersion[]

  @@index([userId, archivedAt])
  @@map("cards")
}

/// Membership of one ProfileField on one Card, plus card-scoped presentation.
/// `visible=false` is a soft hide: the owner can toggle a field off without
/// losing its position or label override. `fieldId` must belong to the same
/// owner as the card — enforced in SharingService, not by the schema (Prisma
/// can't express a cross-row same-owner constraint).
model CardField {
  cardId        String
  fieldId       String
  card          Card         @relation(fields: [cardId], references: [id], onDelete: Cascade)
  field         ProfileField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  visible       Boolean      @default(true)
  position      Int          @default(0)
  labelOverride String?

  @@id([cardId, fieldId])
  @@index([cardId, visible, position])
  @@map("card_fields")
}

/// Immutable snapshot written whenever CardsService.setFields() actually
/// changes the field/visibility/position/label set — never on the
/// appearance-only PATCH. `diff` is computed against version n-1 at write
/// time (empty prior state on the very first version, so `added` is simply
/// every field in the new set — one uniform code path, no special-casing).
///
/// diff shape: { added: [{fieldId,label,type}], removed: [...], changed: [...] }
/// Never contains ProfileField.value — labels only (invariant #5).
model CardVersion {
  id        String   @id @default(uuid())
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  version   Int
  snapshot  Json // full resolved field list at this version: [{fieldId,label,type,visible,position}]
  diff      Json
  createdAt DateTime @default(now())

  @@unique([cardId, version])
  @@index([cardId, version(sort: Desc)])
  @@map("card_versions")
}

enum ContactSource {
  MANUAL // added one at a time via POST /contacts
  IMPORTED // bulk-imported via POST /contacts/import, e.g. from the device address book
  QR_SCAN
  INBOUND
}

/// A person the owner has shared with. Scoped to the owner, not global — the
/// same phone number is a separate Contact row for each owner who shares
/// with them. Deliberately no global "person" entity: that would leak one
/// owner's contacts into another owner's data.
///
/// Sharing a card requires an existing contactId (see ShareLink below) —
/// POST /cards/:id/share no longer accepts an inline phone number. The
/// expected flow is import-then-share, not type-a-number-then-share.
model Contact {
  id          String        @id @default(uuid())
  ownerId     String
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  phoneE164   String
  displayName String? // owner-supplied, or whatever the imported source called them
  notes       String? // owner's private notes, never shown to the contact
  source      ContactSource @default(MANUAL)
  optedOutAt  DateTime? // set on STOP; blocks future sends, existing links stay live

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shareLinks ShareLink[]

  @@unique([ownerId, phoneE164])
  @@index([ownerId, createdAt])
  @@map("contacts")
}

enum ShareLinkStatus {
  ACTIVE
  REVOKED
}

/// THE central entity for live sharing. Unique on (cardId, contactId):
/// sharing the same card with the same person again returns the SAME token,
/// never a new one — see the architecture skill's invariant #1. Re-sending
/// shows updated info because the token was never tied to a snapshot in the
/// first place; GET /public/links/:token always resolves current data.
///
/// `token` is stored in plaintext (never hashed) because the owner needs to
/// re-copy the exact same URL to resend it — see lld.md §5 for why that's an
/// acceptable tradeoff given the token's 128 bits of entropy.
model ShareLink {
  id        String          @id @default(uuid())
  token     String          @unique
  cardId    String
  card      Card            @relation(fields: [cardId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status    ShareLinkStatus @default(ACTIVE)

  firstViewedAt DateTime?
  lastViewedAt  DateTime?
  viewCount     Int       @default(0)
  revokedAt     DateTime?

  /// The Card.currentVersion this contact was last told about, via either
  /// the initial share or an explicit notify. Set on mint/restore in
  /// ShareLinksService.share() — never left null while the link is live, so
  /// "never notified" isn't a reachable state once a link exists; the
  /// meaningful signal is edits happening *after* the last thing they were
  /// told about. Bumped again only after a confirmed WhatsApp send in the
  /// send_whatsapp_card_update outbox handler, not optimistically at enqueue
  /// time — a failed send must still show as "behind."
  lastNotifiedVersion Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cardId, contactId])
  @@index([contactId, status])
  @@index([cardId, status])
  @@map("share_links")
}

/// An anonymous scan of Card.publicToken via GET /public/links/:token. No IP,
/// no fingerprint, no UA string — a scan is a stranger, and this should not
/// become a profile of one. Count + timestamp is enough to answer "has anyone
/// scanned this card" for the sharing dashboard. Recorded on every resolve of
/// the publicToken path, the same way ShareLink.viewCount is bumped on every
/// resolve of a per-contact token — this is that mechanism's card-level twin.
model CardScan {
  id        String   @id @default(uuid())
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([cardId, createdAt])
  @@map("card_scans")
}

// ==========================================
// WHATSAPP TEMPLATES
// ==========================================

enum TemplateStatus {
  APPROVED
  PENDING
  REJECTED
  UNKNOWN
}

/// Registry of Twilio Content templates, keyed by our own semantic `key`
/// rather than the raw contentSid — DB-backed rather than env-var-backed so
/// a template can rotate (new wording, re-approval) without a deploy.
///
/// Empty until a real template is created in Twilio Console and its
/// contentSid registered here. Nothing sends through a template whose
/// approvalStatus isn't APPROVED — see messaging/whatsapp-template.service.ts.
/// A reconciler that syncs approvalStatus from Twilio (the "template
/// reconcile, 10m" cron in lld.md §3) is not built yet; for now a human
/// updates approvalStatus after checking Twilio Console.
model WhatsAppTemplate {
  id              String         @id @default(uuid())
  key             String         @unique // "card_share_initial_en"
  purpose         MessagePurpose
  contentSid      String         @unique
  locale          String         @default("en")
  bodyPreview     String
  buttonLabel     String?
  variableSchema  Json // {"1":"ownerName","2":"linkToken"} — documents Twilio's ContentVariables mapping
  approvalStatus  TemplateStatus @default(UNKNOWN)
  rejectionReason String?
  isActive        Boolean        @default(true)
  syncedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purpose, isActive, approvalStatus])
  @@map("whatsapp_templates")
}

// ==========================================
// OUTBOUND MESSAGING
// ==========================================

enum OutboxStatus {
  PENDING
  CLAIMED
  SENT
  DEFERRED // throttled by the provider; availableAt pushed out
  FAILED // terminal
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessagePurpose {
  OTP
  CARD_SHARE
  CARD_UPDATE
  // SCAN_REPLY lands with QR scanning.
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  UNDELIVERED
  FAILED
}

/// Transactional outbox. Written in the SAME transaction as the domain change
/// (e.g. the OtpChallenge insert), so an enqueue can never be lost — a crash
/// between commit and task creation just leaves this row PENDING for the
/// sweeper to pick up later, rather than silently dropping the message.
///
/// `payload` briefly holds plaintext the send handler needs (e.g. an OTP code)
/// that only ever existed as a hash elsewhere. It is scrubbed after a
/// successful send. This is a deliberate, narrow exception to "never store an
/// OTP in the clear" — anywhere that reads this row into a log line still
/// gets it redacted, since `redact()` matches the `code` key regardless of
/// where it appears.
model OutboxMessage {
  id          String       @id @default(uuid())
  dedupeKey   String       @unique
  kind        String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now())
  claimedAt   DateTime?
  lastError   String?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, availableAt])
  @@index([status, claimedAt])
  @@map("outbox_messages")
}

/// Canonical send ledger. One row per outbound (or inbound) WhatsApp message.
model Message {
  id                String           @id @default(uuid())
  provider          String           @default("twilio")
  providerMessageId String?          @unique
  direction         MessageDirection
  purpose           MessagePurpose
  phoneE164         String
  correlationId     String?
  status            MessageStatus    @default(PENDING)
  errorCode         String?
  errorMessage      String?
  errorClass        String? // PERMANENT | THROTTLED | TRANSIENT | CONFIG
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([phoneE164, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([correlationId])
  @@map("messages")
}

enum InboundMessageSource {
  WHATSAPP_MESSAGE // raw webhook hit, Twilio → POST /webhooks/twilio/inbound
  QR_SCAN_CONNECT // a stranger scanned a card's QR and verified their phone — see sharing/card-connect.service.ts
  CARD_SHARE // an owner shared a card with a contact — see sharing/share-links.service.ts share()
}

/// The interaction/connection log: one row per (fromPhoneE164, toPhoneE164)
/// pair, EVER — not one row per event. A second real WhatsApp message, a
/// second QR-scan-connect, or a re-share with the same contact, between a
/// pair already on file produces no new row; that's what
/// `@@unique([fromPhoneE164, toPhoneE164])` enforces. This was originally
/// message-only (deduped on Twilio's MessageSid); it now also covers the
/// QR-scan "Save & connect" flow and an owner-initiated card share, neither
/// of which is a WhatsApp message Twilio delivered to us — hence `source`
/// and the nullable message-only columns.
///
/// `fromPhoneE164`/`toPhoneE164` mean different things per `source`,
/// deliberately — in every case `from` is whoever's action created this
/// connection, `to` is who they connected with:
///   - WHATSAPP_MESSAGE: from = the sender, to = our fixed business number
///     (so the unique pair degenerates to "one row per sender")
///   - QR_SCAN_CONNECT: from = the scanner (they took the action), to = the
///     scanned card's OWNER's phone (so the same scanner connecting to two
///     different owners still gets two rows — a genuinely distinct
///     connection each time)
///   - CARD_SHARE: from = the OWNER (they took the action), to = the
///     contact's phone (so the same owner sharing multiple different cards
///     with the same contact still logs once — this is "has this owner
///     ever connected with this contact," not "how many cards were shared")
///
/// `resolvedOwnerId` is the "who on our side is this about" field: always
/// set for QR_SCAN_CONNECT and CARD_SHARE (both know exactly which
/// ContactBook User this event is about), always null for WHATSAPP_MESSAGE
/// (no scan-code-in-message-body resolution exists yet — see
/// docs/architecture/hld.md Flow 3).
///
/// `rawPayload` keeps the entire webhook body verbatim so a field nobody
/// thought to add a column for isn't silently lost — the structured columns
/// below are just the ones known to be useful for the GET endpoint today.
model InboundMessage {
  id       String               @id @default(uuid())
  source   InboundMessageSource @default(WHATSAPP_MESSAGE)
  provider String               @default("twilio")
  /// Twilio's MessageSid. Null for QR_SCAN_CONNECT/CARD_SHARE rows, which
  /// have no Twilio delivery behind them at all.
  providerMessageId String? @unique
  fromPhoneE164     String
  toPhoneE164       String
  body              String?
  /// WhatsApp's own display name for the sender, when Twilio provides one —
  /// never something we asked for or verified, just whatever their WhatsApp
  /// profile says at send time.
  profileName     String?
  rawPayload      Json?
  resolvedOwnerId String?
  resolvedOwner   User?    @relation(fields: [resolvedOwnerId], references: [id], onDelete: SetNull)
  receivedAt      DateTime @default(now())

  @@unique([fromPhoneE164, toPhoneE164])
  @@index([fromPhoneE164, receivedAt(sort: Desc)])
  @@index([receivedAt(sort: Desc)])
  @@index([resolvedOwnerId])
  @@map("inbound_messages")
}
